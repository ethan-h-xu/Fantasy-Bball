# Copy to .env.local and fill in from your Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only, so it must not start with NEXT_PUBLIC_. From Project Settings > API Keys.
# Without it the app still works, but rebuilds past seasons from Sleeper on every load.
SUPABASE_SECRET_KEY=your-secret-key
